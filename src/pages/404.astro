---
// GitHub Pages serves this one page for every missing address, so it says so in English and in Japanese.
import Base from "../layouts/Base.astro";
import { docsPage, homePath } from "../data/site";
import { t } from "../i18n";

const en = t("en").notFound;
const ja = t("ja").notFound;
---

<Base title={en.title} description={en.description}>
  <section class="mx-auto flex max-w-[720px] flex-col items-center px-5 py-32 text-center">
    <p class="font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">{en.kicker}</p>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-[-0.04em]">{en.heading}</h1>
    <p class="mt-5 text-lg text-bp-dim">{en.body}</p>
    <p lang="ja" class="mt-3 break-keep text-[15px] leading-relaxed text-bp-faint">{ja.heading}{ja.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={homePath("en")} class="inline-flex min-h-12 items-center rounded-md bg-bp-cta px-5 font-semibold text-bp-cta-ink hover:bg-bp-cta-hover">{en.home}</a>
      <a href={docsPage("en")} class="inline-flex min-h-12 items-center rounded-md border border-bp-rule2 px-5 font-semibold hover:bg-bp-panel">{en.docs}</a>
      <a href={homePath("ja")} lang="ja" class="inline-flex min-h-12 items-center rounded-md border border-bp-rule2 px-5 font-semibold hover:bg-bp-panel">{ja.home}（日本語）</a>
    </div>
  </section>
</Base>
