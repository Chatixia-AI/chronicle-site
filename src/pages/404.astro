---
import Base from "../layouts/Base.astro";
import { links } from "../data/site";
---

<Base title="Not found · Chronicle" description="This page isn't in the record.">
  <section class="mx-auto flex max-w-[720px] flex-col items-center px-5 py-32 text-center">
    <p class="font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">404 · no entry</p>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-[-0.04em]">This page isn't in the record.</h1>
    <p class="mt-5 text-lg text-bp-dim">It may have moved when the docs moved to /docs/.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex min-h-12 items-center rounded-md bg-bp-cta px-5 font-semibold text-bp-cta-ink hover:bg-bp-cta-hover">Home</a>
      <a href={links.docs} class="inline-flex min-h-12 items-center rounded-md border border-bp-rule2 px-5 font-semibold hover:bg-bp-panel">The docs</a>
    </div>
  </section>
</Base>
