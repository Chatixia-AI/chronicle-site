---
// A shell command with a copy button, labelled in the page's language. A long command wraps at its spaces, each
// line after the first indented past the prompt, so it stays readable on a phone. Words never split (not even at
// the hyphens of --bin) and && stays with the word after it, so a line never ends on &&. The button copies all of it.
import type { Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  command: string;
  lang: Lang;
  class?: string;
}
const { command, lang, class: className = "" } = Astro.props;
const s = t(lang).copy;
const words: string[] = [];
for (const word of command.split(" ")) {
  if (words.at(-1) === "&&") words[words.length - 1] += ` ${word}`;
  else words.push(word);
}
---

<div
  class:list={[
    "copy-command flex items-center gap-3 rounded-md border border-bp-rule2/80 bg-bp-bg/90 py-2 pl-4 pr-2 font-plex-mono text-[13px] sm:text-sm",
    className,
  ]}
>
  <code class="min-w-0 flex-1 whitespace-pre-wrap pl-[2ch] -indent-[2ch] leading-relaxed text-bp-ink [overflow-wrap:anywhere]"
    ><span class="select-none text-bp-gold" aria-hidden="true">$ </span>{
      words.map((word, i) => [i ? " " : "", <span class="whitespace-nowrap">{word}</span>])
    }</code
  >
  <button
    type="button"
    data-command={command}
    data-copy={s.copy}
    data-copied={s.copied}
    data-select={s.select}
    aria-label={`${s.copy}: ${command}`}
    class="shrink-0 rounded border border-bp-rule2/70 px-2.5 py-1 font-plex-mono text-[11px] uppercase tracking-[0.12em] text-bp-dim hover:border-bp-gold hover:text-bp-ink"
    >{s.copy}</button
  >
  <!-- Says "Copied" to screen readers too: the button's own name stays the command it copies. -->
  <span class="sr-only" role="status"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-command button")) {
    const status = button.parentElement!.querySelector<HTMLElement>('[role="status"]')!;
    let timer = 0;
    button.addEventListener("click", async () => {
      let message: string;
      try {
        await navigator.clipboard.writeText(button.dataset.command ?? "");
        message = button.dataset.copied ?? "";
      } catch {
        message = button.dataset.select ?? "";
      }
      button.textContent = message;
      status.textContent = message;
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = button.dataset.copy ?? "";
        status.textContent = "";
      }, 1800);
    });
  }
</script>
