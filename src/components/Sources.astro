---
// Which agents Chronicle records, and when.
import SectionHead from "./SectionHead.astro";
import { docsPage, type Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).sources;
---

<section class="border-b border-bp-rule/70">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-5 py-20 sm:px-10 lg:grid-cols-[.9fr_1.1fr] lg:px-16 lg:py-24">
    <SectionHead label={s.label} title={s.title} body={s.body} />
    <ul class="grid content-start gap-2.5">
      {
        s.agents.map((a) => (
          <li class="flex items-center justify-between gap-4 border border-bp-rule2/60 bg-bp-panel/60 px-4 py-3.5">
            <span class="font-semibold">{a.name}</span>
            <span class="text-right font-plex-mono text-[11px] text-bp-faint">{a.when}</span>
          </li>
        ))
      }
      <li class="mt-2 flex items-center border border-dashed border-bp-rule2/60 px-4 py-3.5 text-sm text-bp-dim">
        <span>
          {s.mcp[0]}<a
            href={docsPage(lang, "mcp/")}
            class="text-bp-ink underline decoration-bp-rule2 underline-offset-4 hover:decoration-bp-gold">{s.mcp[1]}</a
          >{s.mcp[2]}
        </span>
      </li>
    </ul>
  </div>
</section>
