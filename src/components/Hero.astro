---
// The opening: one agent learns, and another reuses the lesson with its source intact. Tink keeps the record,
// ticking items off the clipboard.
import CastLoop from "./CastLoop.astro";
import CopyCommand from "./CopyCommand.astro";
import Renamed from "./Renamed.astro";
import Segs from "./Segs.astro";
import { docsPage, installCommand, type Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).hero;
---

<section class="relative isolate overflow-hidden border-b border-bp-rule/70">
  <div
    class="pointer-events-none absolute -left-40 -top-44 h-[600px] w-[600px] rounded-full bg-bp-teal/10 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-1 items-center gap-14 px-5 pb-20 pt-16 sm:px-10 sm:pt-20 lg:min-h-[640px] lg:grid-cols-[1.12fr_.88fr] lg:px-16 lg:py-24"
  >
    <div class="relative z-10 min-w-0">
      <p class="inline-flex items-center gap-3 font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">
        <span class="h-1.5 w-1.5 rotate-45 bg-bp-gold"></span> {s.kicker}
      </p>
      <h1
        class:list={[
          "mt-6 max-w-[720px] font-display font-semibold tracking-[-0.05em]",
          // Kana and kanji are about twice as wide as Latin letters: a smaller size keeps each line whole.
          lang === "ja" ? "text-[clamp(2.2rem,3.6vw,3.1rem)] leading-[1.2]" : "text-[clamp(2.6rem,4.4vw,3.75rem)] leading-[1.02]",
        ]}
      >
        {s.title[0]}
        <br />
        <span class="text-bp-teal">{s.title[1]}</span>
      </h1>
      <p class="mt-7 max-w-[570px] text-lg leading-[1.65] text-bp-dim sm:text-xl">
        {s.body}
      </p>
      <p lang={s.aside.lang} class:list={["mt-3 max-w-[570px] text-[15px] leading-relaxed text-bp-faint", s.aside.lang === "ja" && "break-keep"]}>
        {s.aside.text}
      </p>
      <CopyCommand lang={lang} command={installCommand} class="mt-9 max-w-[570px]" />
      <Renamed lang={lang} class="mt-2 max-w-[570px]" />
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={docsPage(lang, "install/")}
          class="inline-flex min-h-12 items-center gap-2 rounded-md bg-bp-cta px-5 py-3 font-semibold text-bp-cta-ink hover:bg-bp-cta-hover"
          >{s.start} <span aria-hidden="true">→</span></a
        >
        <a
          href="#record"
          class="inline-flex min-h-12 items-center gap-2 rounded-md border border-bp-rule2 px-5 py-3 font-semibold hover:border-bp-teal hover:bg-bp-panel"
          >{s.see} <span aria-hidden="true">↓</span></a
        >
      </div>
      <p class="mt-5 font-plex-mono text-[11px] uppercase tracking-[0.16em] text-bp-faint">
        {s.facts}
      </p>
    </div>

    <figure class="bp-ticks relative mx-auto w-full min-w-0 max-w-[580px] border border-bp-rule2/80 bp-stage p-5 sm:p-7 lg:max-w-none">
      <div class="flex items-center justify-between border-b border-bp-rule/80 pb-3 font-plex-mono text-[10px] uppercase tracking-[0.16em] text-bp-dim">
        <span>{s.card.log}</span>
        <span>Fig. 01</span>
      </div>

      <div class="deck relative mx-auto mt-16 mb-4 max-w-[440px]">
        <div class="card card-3 absolute inset-0 rounded-lg border border-bp-rule2/60 bg-bp-panel/70" aria-hidden="true"></div>
        <div class="card card-2 absolute inset-0 rounded-lg border border-bp-rule2/70 bg-bp-panel/85" aria-hidden="true"></div>
        <article class="card card-1 ledger relative rounded-lg border border-bp-rule2 bg-bp-panel p-5 shadow-[0_24px_60px_-20px_var(--bp-shadow)]">
          <p class="font-plex-mono text-[11px] text-bp-faint">
            {s.card.meta}<span class="text-bp-dim">fix/webhook-idempotency</span>
          </p>
          <h2 class="mt-2 font-display text-lg font-semibold leading-snug">{s.card.title}</h2>
          <p class="mt-2 inline-flex items-center gap-1.5 font-plex-mono text-[11px] uppercase tracking-[0.12em] text-bp-teal">
            <span class="h-1.5 w-1.5 rounded-full bg-bp-teal"></span> {s.card.status}
          </p>
          <div class="mt-4 rounded-md border border-bp-gold/40 bg-bp-bg/70 p-3.5">
            <p class="font-plex-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-bp-gold">{s.card.kind}</p>
            <p class="mt-1 text-[15px] font-semibold leading-snug">{s.card.lesson}</p>
            <p class="mt-1.5 text-[13px] leading-relaxed text-bp-dim">
              <Segs segs={s.card.detail} />
            </p>
          </div>
        </article>
        <CastLoop
          name="hero"
          alt={s.card.tink}
          width={380}
          height={260}
          eager
          class="pointer-events-none absolute -bottom-10 -right-6 w-[150px] drop-shadow-[0_12px_24px_rgba(0,0,0,.5)] sm:-right-12 sm:w-[190px]"
        />
      </div>

      <div class="relative mt-14 rounded-md border border-bp-teal/40 bg-bp-bg/70 p-4">
        <span class="absolute -top-8 left-5 h-8 border-l border-dashed border-bp-teal/60" aria-hidden="true"></span>
        <p class="font-plex-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-bp-teal">{s.card.next}</p>
        <p class="mt-2 text-sm leading-relaxed text-bp-ink">{s.card.reuse}</p>
        <p class="mt-3 border-t border-bp-rule/70 pt-2 font-plex-mono text-[10px] leading-relaxed text-bp-dim">{s.card.source}</p>
      </div>

      <figcaption class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-bp-rule/80 pt-3 font-plex-mono text-[10px] uppercase tracking-[0.15em] text-bp-dim">
        <span>{s.card.caption}</span>
        <span class="text-bp-gold">{s.card.keeper}</span>
      </figcaption>
    </figure>
  </div>
</section>
