---
// The opening: the promise on the left, a deck of logged sessions on the right with Tink keeping the record.
import CopyCommand from "./CopyCommand.astro";
import { installCommand, links } from "../data/site";
---

<section class="relative isolate overflow-hidden border-b border-bp-rule/70">
  <div
    class="pointer-events-none absolute -left-40 -top-44 h-[600px] w-[600px] rounded-full bg-bp-teal/10 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-1 items-center gap-14 px-5 pb-20 pt-16 sm:px-10 sm:pt-20 lg:min-h-[640px] lg:grid-cols-[1.12fr_.88fr] lg:px-16 lg:py-24"
  >
    <div class="relative z-10 min-w-0">
      <p class="inline-flex items-center gap-3 font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">
        <span class="h-1.5 w-1.5 rotate-45 bg-bp-gold"></span> A logbook for your coding agents
      </p>
      <h1 class="mt-6 max-w-[720px] font-display text-[clamp(2.6rem,4.4vw,3.75rem)] font-semibold leading-[1.02] tracking-[-0.05em]">
        Your agents forget.
        <br />
        <span class="text-bp-teal">Chronicle remembers.</span>
      </h1>
      <p class="mt-7 max-w-[570px] text-lg leading-[1.65] text-bp-dim sm:text-xl">
        Claude Code deletes transcripts after 30 days, and nothing carries a fix from one session to the next. Chronicle
        keeps every session from Claude Code, Codex, Copilot and IBM Bob on your Mac, writes down what was learned, and
        hands it back to you and your agents.
      </p>
      <p lang="ja" class="mt-3 max-w-[570px] break-keep text-[15px] leading-relaxed text-bp-faint">
        コーディングエージェントのすべてのセッションを、検索できる記憶に。
      </p>
      <CopyCommand command={installCommand} class="mt-9 max-w-[570px]" />
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={links.install}
          class="inline-flex min-h-12 items-center gap-2 rounded-md bg-bp-cta px-5 py-3 font-semibold text-bp-cta-ink hover:bg-bp-cta-hover"
          >Get started <span aria-hidden="true">→</span></a
        >
        <a
          href="#record"
          class="inline-flex min-h-12 items-center gap-2 rounded-md border border-bp-rule2 px-5 py-3 font-semibold hover:border-bp-teal hover:bg-bp-panel"
          >See what it keeps <span aria-hidden="true">↓</span></a
        >
      </div>
      <p class="mt-5 font-plex-mono text-[11px] uppercase tracking-[0.16em] text-bp-faint">
        macOS 13+ · free and open source · no telemetry
      </p>
    </div>

    <figure class="bp-ticks relative mx-auto w-full min-w-0 max-w-[580px] border border-bp-rule2/80 bp-stage p-5 sm:p-7 lg:max-w-none">
      <div class="flex items-center justify-between border-b border-bp-rule/80 pb-3 font-plex-mono text-[10px] uppercase tracking-[0.16em] text-bp-dim">
        <span>Log · billing-api</span>
        <span>Fig. 01</span>
      </div>

      <div class="deck relative mx-auto mt-16 mb-4 max-w-[440px]">
        <div class="card card-3 absolute inset-0 rounded-lg border border-bp-rule2/60 bg-bp-panel/70" aria-hidden="true"></div>
        <div class="card card-2 absolute inset-0 rounded-lg border border-bp-rule2/70 bg-bp-panel/85" aria-hidden="true"></div>
        <article class="card card-1 ledger relative rounded-lg border border-bp-rule2 bg-bp-panel p-5 shadow-[0_24px_60px_-20px_var(--bp-shadow)]">
          <p class="font-plex-mono text-[11px] text-bp-faint">
            Today 14:52 · Claude Code · <span class="text-bp-dim">fix/webhook-idempotency</span>
          </p>
          <h2 class="mt-2 font-display text-lg font-semibold leading-snug">Stop double charges when Stripe retries invoice.paid</h2>
          <p class="mt-2 inline-flex items-center gap-1.5 font-plex-mono text-[11px] uppercase tracking-[0.12em] text-bp-teal">
            <span class="h-1.5 w-1.5 rounded-full bg-bp-teal"></span> completed · 4 lessons kept
          </p>
          <div class="mt-4 rounded-md border border-bp-gold/40 bg-bp-bg/70 p-3.5">
            <p class="font-plex-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-bp-gold">Gotcha</p>
            <p class="mt-1 text-[15px] font-semibold leading-snug">Stripe webhook signatures need the raw request body</p>
            <p class="mt-1.5 text-[13px] leading-relaxed text-bp-dim">
              Parsing to JSON first fails with <code class="font-plex-mono text-bp-ink">SignatureVerificationError</code>. Read{" "}
              <code class="font-plex-mono text-bp-ink">await request.body()</code> and pass that.
            </p>
          </div>
        </article>
        <img
          src="/images/tink.webp"
          alt="Tink, Chronicle's guide from the Blueprint Cast: a small robot with a checklist, beside a scroll of log lines"
          width="720"
          height="494"
          class="pointer-events-none absolute -bottom-10 -right-6 w-[150px] drop-shadow-[0_12px_24px_rgba(0,0,0,.5)] sm:-right-12 sm:w-[190px]"
        />
      </div>

      <figcaption class="mt-10 flex items-center justify-between border-t border-bp-rule/80 pt-3 font-plex-mono text-[10px] uppercase tracking-[0.15em] text-bp-dim">
        <span>Every session, kept and read</span>
        <span class="text-bp-gold">Tink keeps the record</span>
      </figcaption>
    </figure>
  </div>
</section>
