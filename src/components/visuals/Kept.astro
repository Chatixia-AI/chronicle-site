---
// The archive: sessions from several agents, the oldest past the day Claude Code would have cleared it.
import Frame from "./Frame.astro";
import type { Lang } from "../../data/site";
import { t } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).visuals.kept;
---

<Frame caption={s.caption} fig="Fig. 02" note={s.note}>
  <ul class="divide-y divide-bp-rule/70">
    {
      s.rows.map((r) => (
        <li class="grid grid-cols-[3.2rem_1fr] gap-3 py-2.5">
          <span class="pt-0.5 font-plex-mono text-[11px] text-bp-faint">{r.when}</span>
          <div class="min-w-0">
            <p class="truncate text-[14px] font-medium">{r.title}</p>
            <p class="mt-0.5 font-plex-mono text-[11px] text-bp-faint">
              {r.agent} · {r.project}
              {r.old && (
                <span class="ml-1.5 text-bp-teal">
                  · <s class="text-bp-faint decoration-bp-gold">{s.deleted}</s> {s.kept}
                </span>
              )}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Frame>
