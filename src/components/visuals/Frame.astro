---
// The drawing frame every visual sits in: a caption bar, the figure, a footer note.
interface Props {
  caption: string;
  fig: string;
  note?: string;
}
const { caption, fig, note } = Astro.props;
---

<figure class="bp-ticks border border-bp-rule2/80 bg-bp-panel/60 p-4 sm:p-5">
  <div class="flex items-center justify-between border-b border-bp-rule/80 pb-2.5 font-plex-mono text-[10px] uppercase tracking-[0.16em] text-bp-dim">
    <span>{caption}</span>
    <span>{fig}</span>
  </div>
  <div class="pt-4">
    <slot />
  </div>
  {
    note && (
      <figcaption class="mt-4 border-t border-bp-rule/80 pt-2.5 font-plex-mono text-[10px] uppercase tracking-[0.15em] text-bp-faint">
        {note}
      </figcaption>
    )
  }
</figure>
