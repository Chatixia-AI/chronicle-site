---
// Codex retrieves a Copilot lesson through Interlatch's MCP server, keeping the source visible.
import Frame from "./Frame.astro";
import Segs from "../Segs.astro";
import type { Lang } from "../../data/site";
import { t } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).visuals.ask;
---

<Frame caption={s.caption} fig="Fig. 04" note={s.note}>
  <div class="theme-dark rounded-md border border-bp-rule/80 bg-[#06142a] p-4 font-plex-mono text-[12.5px] leading-[1.7] [overflow-wrap:anywhere]">
    <p>
      <span class="text-bp-gold">{s.you}</span>{" "}
      <span class="text-bp-ink">{s.question}</span>
    </p>
    <p class="mt-3 text-bp-faint">
      <span class="text-bp-teal">●</span> interlatch · search_knowledge("AssumeRoleWithWebIdentity")
    </p>
    <p class="pl-4 text-bp-faint">└ {s.found}</p>
    <p class="mt-3">
      <span class="text-bp-blue">{s.agent}</span>{" "}
      <span class="text-bp-dim"><Segs segs={s.answer} codeClass="font-plex-mono text-bp-ink" /></span>
    </p>
    <p class="mt-4 border-t border-bp-rule/80 pt-3 text-[11px] text-bp-faint">{s.source}</p>
  </div>
</Frame>
