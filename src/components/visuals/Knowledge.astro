---
// Knowledge pulled from one session, word for word from the demo data (translated on the Japanese page).
import Frame from "./Frame.astro";
import type { Lang } from "../../data/site";
import { t } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).visuals.knowledge;
// Each kind's colour, in the order of s.items; the command is set in monospace.
const looks = [
  { color: "text-bp-teal border-bp-teal/40" },
  { color: "text-bp-blue border-bp-blue/40" },
  { color: "text-bp-gold border-bp-gold/40", mono: true },
];
const items = s.items.map((item, i) => ({ ...item, ...looks[i] }));
---

<Frame caption={s.caption} fig="Fig. 03" note={s.note}>
  <div class="space-y-3">
    {
      items.map((k) => (
        <article class:list={["rounded-md border bg-bp-bg/70 p-3.5", k.color]}>
          <p class="font-plex-mono text-[10px] font-semibold uppercase tracking-[0.16em]">{k.kind}</p>
          <p class="mt-1 text-[15px] font-semibold leading-snug text-bp-ink">{k.title}</p>
          <p class:list={["mt-1 text-[13px] leading-relaxed text-bp-dim", k.mono && "font-plex-mono text-[12px]"]}>{k.body}</p>
        </article>
      ))
    }
  </div>
</Frame>
