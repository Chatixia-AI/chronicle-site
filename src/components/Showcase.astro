---
// The dashboard, one screen at a time: tabs over real screenshots taken on the demo data.
import SectionHead from "./SectionHead.astro";
import { docsPage, type Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).showcase;
// The screenshots, in the order of s.shots. They show the dashboard in English, on the demo data.
const images = [
  { id: "home", src: "/images/home.webp" },
  { id: "session", src: "/images/session.webp" },
  { id: "search", src: "/images/palette.webp" },
  { id: "map", src: "/images/map.webp" },
  { id: "project", src: "/images/project.webp" },
  { id: "review", src: "/images/reviews.webp" },
];
const shots = s.shots.map((shot, i) => ({ ...shot, ...images[i] }));
---

<section id="dashboard" class="scroll-mt-20 border-b border-bp-rule/70">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-10 lg:px-16 lg:py-28">
    <SectionHead label={s.label} title={s.title} body={s.body} />

    <figure class="bp-ticks mt-12 border border-bp-rule2/80 bg-bp-panel/60 p-3 sm:p-4">
      <div class="flex items-center justify-between pb-3 font-plex-mono text-[10px] uppercase tracking-[0.16em] text-bp-dim">
        <span>{s.tour}</span>
        <span>Fig. 06</span>
      </div>
      <video
        class="demo-video w-full rounded border border-bp-rule/70 bg-bp-bg"
        src="/media/demo.mp4"
        poster="/media/demo-poster.webp"
        width="1440"
        height="900"
        controls
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={s.tourAlt}
      ></video>
      <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 font-plex-mono text-[11px] uppercase tracking-[0.12em] text-bp-dim">
        <span class="font-body text-[13px] normal-case tracking-normal">
          {s.tourText}
        </span>
        <span class="text-bp-faint">{s.demo}</span>
      </figcaption>
    </figure>

    <p class="mt-14 font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">{s.screens}</p>
    <div class="showcase mt-5">
      <div role="tablist" aria-label={s.tablist} class="flex flex-wrap gap-2">
        {
          shots.map((shot, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${shot.id}`}
              aria-controls={`panel-${shot.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="rounded-md border border-bp-rule2/70 px-4 py-2 font-plex-mono text-[12px] uppercase tracking-[0.12em] text-bp-dim hover:text-bp-ink aria-selected:border-bp-gold aria-selected:bg-bp-panel aria-selected:text-bp-ink"
            >
              {shot.label}
            </button>
          ))
        }
      </div>
      {
        shots.map((shot, i) => (
          <div role="tabpanel" id={`panel-${shot.id}`} aria-labelledby={`tab-${shot.id}`} hidden={i !== 0} class="mt-6">
            <figure class="bp-ticks border border-bp-rule2/80 bg-bp-panel/60 p-3 sm:p-4">
              <img
                src={shot.src}
                alt={shot.alt}
                width="1440"
                height="900"
                loading={i === 0 ? "eager" : "lazy"}
                class="w-full rounded border border-bp-rule/70"
              />
              <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 font-plex-mono text-[11px] uppercase tracking-[0.12em] text-bp-dim">
                <span class="normal-case tracking-normal text-[13px] font-body text-bp-dim">{shot.text}</span>
                <span class="text-bp-faint">{s.demo}</span>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>

    <p class="mt-16 font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">{s.more}</p>
    <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.extras.map((x) => (
          <li class="bp-ticks flex flex-col border border-bp-rule2/70 bg-bp-panel/60 p-5">
            <h3 class="font-display text-lg font-semibold tracking-tight">
              <a href={docsPage(lang, x.page)} class="hover:text-bp-gold">{x.title}</a>
            </h3>
            <p class="mt-2 text-[15px] leading-relaxed text-bp-dim">{x.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".showcase")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>

<script>
  // Play the tour while it's on screen, muted; leave it still for visitors who asked for less motion.
  const video = document.querySelector<HTMLVideoElement>(".demo-video");
  if (video && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
  }
</script>
