---
// What Chronicle does, as entries in a logbook hung off a spine: each a claim, a scenario and a picture of it.
import SectionHead from "./SectionHead.astro";
import VisualKept from "./visuals/Kept.astro";
import VisualKnowledge from "./visuals/Knowledge.astro";
import VisualAsk from "./visuals/Ask.astro";
import VisualEditor from "./visuals/Editor.astro";
import { docsPage, type Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).record;
// Each entry's drawing and "read more" page, in the order of s.entries.
const extras = [
  { page: "analysis/", Visual: VisualKept },
  { page: "analysis/", Visual: VisualKnowledge },
  { page: "mcp/", Visual: VisualAsk },
  { page: "vscode/", Visual: VisualEditor },
];
const entries = s.entries.map((e, i) => ({ ...e, href: docsPage(lang, extras[i].page), Visual: extras[i].Visual }));
---

<section id="record" class="scroll-mt-20 border-b border-bp-rule/70">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-10 lg:px-16 lg:py-28">
    <SectionHead label={s.label} title={s.title} body={s.body} />

    <ol class="spine mt-16 space-y-20 lg:space-y-28">
      {
        entries.map((e, i) => (
          <li class="relative grid grid-cols-1 items-center gap-10 pl-10 lg:grid-cols-2 lg:gap-24 lg:pl-0">
            <span
              class="absolute left-[5px] top-1 h-[13px] w-[13px] rotate-45 border-2 border-bp-gold bg-bp-bg lg:left-1/2 lg:top-1/2 lg:-ml-[6px] lg:-mt-[6px]"
              aria-hidden="true"
            />
            <div class:list={["min-w-0 max-w-[520px]", i % 2 ? "lg:order-2 lg:justify-self-start" : "lg:justify-self-end"]}>
              <p class="font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-teal">
                {s.entry} {String(i + 1).padStart(2, "0")} · {e.tag}
              </p>
              <h3 class="mt-3 font-display text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-4xl">{e.title}</h3>
              <p class="mt-4 text-[17px] leading-[1.7] text-bp-dim">{e.body}</p>
              <a
                href={e.href}
                class="mt-5 inline-flex items-center gap-1.5 font-semibold text-bp-gold hover:text-bp-ink"
              >
                {e.more} <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class:list={["w-full min-w-0 max-w-[560px]", i % 2 ? "lg:order-1 lg:justify-self-end" : "lg:justify-self-start"]}>
              <e.Visual lang={lang} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
