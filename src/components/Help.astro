---
import { docsPage, links, type Lang } from "../data/site";
import { updates } from "../data/updates";
import { t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).help;
const latest = await updates;
const dateFormat = new Intl.DateTimeFormat(lang === "ja" ? "ja-JP" : "en-US", {
  year: "numeric", month: "short", day: "numeric", timeZone: "UTC",
});
const community = [
  [s.qa, links.qa],
  [s.ideas, links.ideas],
  [s.roadmap, lang === "ja" ? links.roadmapJa : links.roadmap],
  [s.announcements, links.announcements],
  [s.issues, links.issues],
  [s.contributing, links.contributing],
];
---

<section id="help" aria-labelledby="help-heading" class="scroll-mt-20 border-t border-bp-rule/70 bg-bp-panel/30">
  <div class="mx-auto max-w-[1280px] px-5 py-14 sm:px-10 lg:px-16 lg:py-16">
    <p class="font-plex-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-bp-gold">{s.label}</p>
    <h2 id="help-heading" class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{s.title}</h2>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      <article aria-labelledby="updates-heading" class="min-w-0 border border-bp-rule2/60 bg-bp-panel/60 p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h3 id="updates-heading" class="font-display text-xl font-semibold">{s.updates}</h3>
          <a href={links.changelog} class="shrink-0 font-plex-mono text-[11px] text-bp-dim underline underline-offset-4 hover:text-bp-ink">{s.viewAll}</a>
        </div>
        <ul class="mt-5 space-y-5">
          {latest.map((update) => (
            <li>
              <a href={update.href} lang="en" class="leading-relaxed text-bp-dim hover:text-bp-ink">{update.title}</a>
              <p class="mt-1 font-plex-mono text-[11px] text-bp-faint">
                <span>{update.version}</span> · <time datetime={update.date}>{dateFormat.format(new Date(`${update.date}T00:00:00Z`))}</time>
              </p>
            </li>
          ))}
          {latest.length === 0 && <li><a href={links.changelog} class="text-bp-dim underline underline-offset-4 hover:text-bp-ink">{s.changelogFallback}</a></li>}
        </ul>
      </article>
      <article aria-labelledby="guides-heading" class="min-w-0 border border-bp-rule2/60 bg-bp-panel/60 p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h3 id="guides-heading" class="font-display text-xl font-semibold">{s.guides}</h3>
          <a href={docsPage(lang)} class="shrink-0 font-plex-mono text-[11px] text-bp-dim underline underline-offset-4 hover:text-bp-ink">{s.viewAll}</a>
        </div>
        <ul class="mt-5 space-y-5">
          {s.guideItems.map((guide) => (
            <li>
              <a href={docsPage(lang, guide.page)} class="font-semibold leading-relaxed hover:text-bp-teal">{guide.title}</a>
              <p class="mt-1 text-sm leading-relaxed text-bp-dim">{guide.body}</p>
            </li>
          ))}
        </ul>
      </article>
      <article aria-labelledby="community-heading" class="min-w-0 border border-bp-rule2/60 bg-bp-panel/60 p-6">
        <h3 id="community-heading" class="font-display text-xl font-semibold">{s.community}</h3>
        <ul class="mt-3 divide-y divide-bp-rule/70">
          {community.map(([label, href]) => (
            <li><a href={href} class="flex min-h-11 items-center justify-between gap-3 py-2 text-sm text-bp-dim hover:text-bp-ink">{label}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
