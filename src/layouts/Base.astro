---
// Every page's shell: head, header and footer, in the Chatixia blueprint style, in English or Japanese.
import "../styles/global.css";
import { repoStats } from "../data/repo";
import { docsPage, homePath, links, productName, type Lang } from "../data/site";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** The page exists in both languages (the home page): declare the other one to search engines (hreflang). */
  translated?: boolean;
  /** Keep the page out of search results (the 404 page): no canonical or og:url, which it has no address of its own for. */
  noindex?: boolean;
}
const { title, description, lang = "en", translated = false, noindex = false } = Astro.props;
const s = t(lang).base;
const other: Lang = lang === "ja" ? "en" : "ja";
const home = homePath(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
// The social preview image, at its real size. https://interlatch.com/... works only once the domain is connected.
const ogImage = { url: new URL("/images/home.webp", Astro.site), width: 1440, height: 900 };
// In page order; show links inline from xl up so both languages fit, and in the menu below that. GitHub is inline as
// the icon with its stars and forks at the right instead.
const nav = [
  { label: s.nav.install, href: `${home}#install` },
  { label: s.nav.record, href: `${home}#record` },
  { label: s.nav.team, href: `${home}#team` },
  { label: s.nav.faq, href: `${home}#faq` },
  { label: s.nav.docs, href: docsPage(lang) },
  { label: s.nav.github, href: links.github },
];
const stats = await repoStats;
const count = new Intl.NumberFormat(lang, { notation: "compact" });
const github = stats
  ? s.github.counted.replace("{stars}", String(stats.stars)).replace("{forks}", String(stats.forks))
  : s.github.label;
const footer = [
  {
    title: s.footer.product,
    items: [
      [s.nav.install, `${home}#install`],
      [s.nav.record, `${home}#record`],
      [s.nav.team, `${home}#team`],
      [s.nav.faq, `${home}#faq`],
      [s.footer.releases, links.releases],
      [s.footer.changelog, links.changelog],
      [s.footer.roadmap, lang === "ja" ? links.roadmapJa : links.roadmap],
    ],
  },
  {
    title: s.footer.docs,
    items: [
      [s.footer.gettingStarted, docsPage(lang, "install/")],
      [s.footer.mcp, docsPage(lang, "mcp/")],
      [s.footer.vscode, docsPage(lang, "vscode/")],
      [s.footer.hub, docsPage(lang, "join-a-hub/")],
      [s.footer.otherDocs.label, s.footer.otherDocs.page],
    ],
  },
  {
    title: s.footer.elsewhere,
    items: [
      ["GitHub", links.github],
      [s.footer.community, links.qa],
      [s.footer.ideas, links.ideas],
      [s.footer.issues, links.issues],
      [s.footer.contributing, links.contributing],
      ["PyPI", links.pypi],
      ["chatixia.net", links.chatixia],
    ],
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      translated && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(homePath("en"), Astro.site)} />
          <link rel="alternate" hreflang="ja" href={new URL(homePath("ja"), Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(homePath("en"), Astro.site)} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    {translated && <meta property="og:locale:alternate" content={other === "ja" ? "ja_JP" : "en_US"} />}
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={s.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={s.imageAlt} />
    <meta name="theme-color" content="#081a31" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f7fb" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Set the theme before the first paint: the visitor's choice if they made one, else the system's.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("interlatch-theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: light)");
        const apply = (t) => (document.documentElement.dataset.theme = t);
        apply(stored === "light" || stored === "dark" ? stored : system.matches ? "light" : "dark");
        if (!stored) system.addEventListener("change", (e) => apply(e.matches ? "light" : "dark"));
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- IBM Plex Sans JP only on the Japanese page: its CSS alone is about 90 KB. The few Japanese words on an English
         page use the system's Japanese font. -->
    <link
      href={`https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400${lang === "ja" ? "&family=IBM+Plex+Sans+JP:wght@400;500;600" : ""}&family=IBM+Plex+Mono:wght@400;500;600&display=swap`}
      rel="stylesheet"
    />
  </head>
  <body class="bp-paper min-h-screen font-body text-bp-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-bp-cta focus:px-3 focus:py-2 focus:text-bp-cta-ink"
      >{s.skip}</a
    >
    <header class="sticky top-0 z-40 border-b border-bp-rule/70 bg-bp-bg/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-[1280px] items-center gap-3 px-5 sm:gap-6 sm:px-10 lg:px-16">
        <a href={home} class="flex shrink-0 items-center gap-2.5" aria-label={s.home}>
          <img src="/images/icon.webp" alt="" width="28" height="28" class="h-7 w-7" />
          <span class="font-display text-lg font-semibold tracking-tight">{productName}</span>
          <span class="hidden font-plex-mono text-[10px] uppercase tracking-[0.18em] text-bp-faint sm:inline">{s.by}</span>
        </a>
        <nav aria-label={s.nav.label} class="ml-auto hidden items-center gap-7 text-sm text-bp-dim xl:flex">
          {nav.filter((item) => item.href !== links.github).map((item) => <a href={item.href} class="whitespace-nowrap hover:text-bp-ink">{item.label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-3 xl:ml-0">
          <!-- Below xl the links above don't fit: the same links in a menu. A <details> opens and closes from the
               keyboard as well as the mouse; the script below closes it on Escape, on a click outside and on a link. -->
          <details class="site-menu xl:hidden">
            <summary
              aria-label={s.menu}
              title={s.menu}
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-bp-rule2/50 text-bp-dim hover:text-bp-ink"
            >
              <svg class="open h-[16px] w-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
                ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
              >
              <svg class="close h-[16px] w-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
                ><path d="M6 6l12 12M18 6L6 18"></path></svg
              >
            </summary>
            <nav aria-label={s.nav.label} class="absolute inset-x-0 top-full border-b border-bp-rule/70 bg-bp-bg shadow-[0_18px_40px_-24px_var(--bp-shadow)]">
              <ul class="mx-auto max-w-[1280px] px-5 py-2 sm:px-10">
                {
                  nav.map((item) => (
                    <li class="border-b border-bp-rule/50 last:border-0">
                      <a href={item.href} class="flex min-h-11 items-center whitespace-nowrap text-base text-bp-dim hover:text-bp-ink">
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
          <a
            href={`${home}#install`}
            class="hidden min-h-10 items-center whitespace-nowrap rounded-md bg-bp-cta px-4 text-sm font-semibold text-bp-cta-ink hover:bg-bp-cta-hover min-[400px]:inline-flex"
            >{s.cta}</a
          >
          <!-- The repository, with its stars and forks from sm up (read at build time; the mark alone if that failed). -->
          <a
            href={links.github}
            aria-label={github}
            title={github}
            class="flex h-8 items-center divide-x divide-bp-rule2/50 rounded-md border border-bp-rule2/50 text-bp-faint hover:text-bp-ink"
          >
            <span class="flex h-full w-8 items-center justify-center">
              <svg class="h-[15px] w-[15px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                ><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
                ></path></svg
              >
            </span>
            {
              stats && (
                <>
                  <span class="hidden h-full items-center gap-1.5 px-2.5 font-plex-mono text-xs sm:flex">
                    <svg class="h-[13px] w-[13px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z" />
                    </svg>
                    {count.format(stats.stars)}
                  </span>
                  <span class="hidden h-full items-center gap-1.5 px-2.5 font-plex-mono text-xs sm:flex">
                    <svg class="h-[13px] w-[13px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
                    </svg>
                    {count.format(stats.forks)}
                  </span>
                </>
              )
            }
          </a>
          <!-- The language link and the theme toggle: one small control at the far right, the same size on every page,
               so after switching language the way back is right under the pointer. -->
          <div class="flex h-8 items-center divide-x divide-bp-rule2/50 rounded-md border border-bp-rule2/50 text-bp-faint">
            <a
              href={homePath(other)}
              hreflang={other}
              lang={other}
              title={s.other.title}
              class="flex h-full w-16 items-center justify-center text-xs hover:text-bp-ink"
            >
              {s.other.label}
            </a>
            <button
              type="button"
              class="theme-toggle flex h-full w-8 items-center justify-center hover:text-bp-ink"
              data-to-light={s.theme.light}
              data-to-dark={s.theme.dark}
              aria-label={s.theme.light}
              title={s.theme.light}
            >
              <svg class="sun h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
                ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg
              >
              <svg class="moon h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
              >
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-bp-rule/70 bg-bp-bg/80">
      <div class="mx-auto grid max-w-[1280px] gap-10 px-5 py-14 sm:px-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] lg:px-16">
        <div>
          <div class="flex items-center gap-2.5">
            <img src="/images/icon.webp" alt="" width="24" height="24" class="h-6 w-6" />
            <span class="font-display font-semibold">{productName}</span>
          </div>
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-bp-dim">
            {s.footer.blurb[0]}<a href={links.chatixia} class="text-bp-ink underline decoration-bp-rule2 underline-offset-4 hover:decoration-bp-gold">Chatixia</a>{s.footer.blurb[1]}
          </p>
          <p class="mt-4 font-plex-mono text-[11px] uppercase tracking-[0.16em] text-bp-faint">{s.footer.license}</p>
        </div>
        {
          footer.map((col) => (
            <div>
              <p class="font-plex-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-bp-gold">{col.title}</p>
              <ul class="mt-4 space-y-2.5 text-sm text-bp-dim">
                {col.items.map(([label, href]) => (
                  <li>
                    <a href={href} class="hover:text-bp-ink">{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </footer>
    <script>
      // The header toggle flips the theme and remembers the choice (when storage is allowed). Its label, in the
      // page's language, says where it will take you.
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
      const label = () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        const text = (next === "light" ? toggle.dataset.toLight : toggle.dataset.toDark) ?? "";
        toggle.setAttribute("aria-label", text);
        toggle.title = text;
      };
      label();
      toggle.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("interlatch-theme", next); } catch {}
        label();
      });
      new MutationObserver(label).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

      // The narrow-screen menu closes on Escape (focus goes back to its button), on a click outside it, and when one
      // of its links is followed: most of them are on this page, so nothing else would close it.
      const menu = document.querySelector<HTMLDetailsElement>(".site-menu")!;
      const summary = menu.querySelector("summary")!;
      menu.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !menu.open) return;
        menu.open = false;
        summary.focus();
      });
      document.addEventListener("click", (e) => {
        if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
      for (const link of menu.querySelectorAll("a")) link.addEventListener("click", () => (menu.open = false));
    </script>
  </body>
</html>
